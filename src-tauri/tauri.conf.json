{
  "$schema": "https://raw.githubusercontent.com/nicholasq/tauri-app-settings-schema/main/schema.json",
  "productName": "MinIO Drive",
  "version": "0.1.0",
  "identifier": "com.minio-drive.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "MinIO Drive",
        "width": 800,
        "height": 600,
        "visible": true,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/rclone"],
    "resources": []
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
